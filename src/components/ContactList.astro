---
/** Contact links (S7). Email is never in the HTML as a whole address: ui.ts builds the mailto. */
import { site } from '../data/site';
import { t, type Lang, type UiKey } from '../i18n/ui';

interface Props {
  /** Dictionary key of the list's aria-label. */
  label?: UiKey;
  lang?: Lang;
}
const { label = 'contact.label', lang = 'en' } = Astro.props;
const tr = t(lang);
const { github, linkedin, dev, cv, email } = site.links;
---

<ul class="contact" aria-label={tr(label)}>
  <li><a href={github}>GitHub</a></li>
  <li><a href={linkedin}>LinkedIn</a></li>
  <li><a href={dev}>DEV</a></li>
  <li><a href={cv}>{tr('contact.resumePdf')}</a></li>
  <li>
    <span class="em" data-email data-u={email.user} data-d={email.domain}>{email.user} [at] {email.domain}</span>
    <button type="button" class="btn sm" data-copy hidden data-copied={tr('contact.copied')}>{tr('contact.copyEmail')}</button>
  </li>
</ul>
