---
/**
 * The Spanish DRAFT flag (S3): "BORRADOR — traducción a revisar por Teo", once near the top of
 * every Spanish page until Teo approves the translation. English pages carry their own
 * "DRAFT — Teo rewrites" flags next to the copy that is still a draft, so this renders nothing there.
 */
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
---

{lang === 'es' && <p><span class="draft">{t(lang)('draft')}</span></p>}
