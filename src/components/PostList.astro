---
/** DEV posts list (artboard .posts), oldest first like the artboard unless `newestFirst`. */
import { getCollection } from 'astro:content';

interface Props {
  newestFirst?: boolean;
}
const { newestFirst = false } = Astro.props;
const posts = (await getCollection('writing')).sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
if (newestFirst) posts.reverse();
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<ul class="posts">
  {posts.map((p) => (
    <li><time datetime={iso(p.data.date)}>{iso(p.data.date)}</time><a href={p.data.url}>{p.data.title}</a></li>
  ))}
</ul>
