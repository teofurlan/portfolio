---
/** Placeholder pages (build session P4, decoration archive P5), both languages. */
import DraftFlag from '../DraftFlag.astro';
import Base from '../../layouts/Base.astro';
import type { Lang } from '../../i18n/ui';
import { getContent } from '../../lib/i18n-content';

interface Props {
  lang: Lang;
  page: 'buildSession' | 'decoration';
}
const { lang, page } = Astro.props;
const c = getContent(lang)[page];
---

<Base title={c.title} lang={lang}>
  <h1>{c.title}</h1>
  <DraftFlag lang={lang} />
  <p>{c.text}</p>
</Base>
