---
/** Placeholder page (build session P4), both languages. */
import Base from '../../layouts/Base.astro';
import type { Lang } from '../../i18n/ui';
import { getContent } from '../../lib/i18n-content';

interface Props {
  lang: Lang;
  page: 'buildSession';
}
const { lang, page } = Astro.props;
const c = getContent(lang)[page];
---

<Base title={c.title} lang={lang}>
  <h1>{c.title}</h1>
  <p>{c.text}</p>
</Base>
