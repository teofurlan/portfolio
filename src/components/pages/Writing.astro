---
import PostList from '../PostList.astro';
import Base from '../../layouts/Base.astro';
import type { Lang } from '../../i18n/ui';
import { getContent } from '../../lib/i18n-content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = getContent(lang).writing;
---

<Base title={c.title} description={c.description} lang={lang}>
  <h1>{c.title}</h1>
  <section class="sheet" aria-labelledby="h-posts">
    <div class="sh"><h2 id="h-posts">{c.heading}</h2><span class="mono sub-ink">{c.sub}</span></div>
    <PostList newestFirst lang={lang} />
    <p><a href="/rss.xml">{c.rss}</a> · <a href="https://dev.to/teo_furlan">{c.all}</a></p>
  </section>
</Base>
