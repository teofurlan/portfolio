---
import Base from '../../layouts/Base.astro';
import { alternate } from '../../i18n/routes';
import { slots, t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
---

<Base title={tr('notfound.title')} noCanonical lang={lang}>
  <h1>{tr('notfound.title')}</h1>
  <p>{slots(tr('notfound.body')).map((s) => ('text' in s ? s.text : <a href={alternate('/', lang)}>{tr('notfound.home')}</a>))}</p>
  <slot />
</Base>
