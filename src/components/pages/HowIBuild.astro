---
/** "How I build with AI" essay, both languages. Text lives in content/i18n/<lang>/site.json. */
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../i18n/ui';
import { getContent } from '../../lib/i18n-content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const c = getContent(lang).ai;
const l = c.figureLabels;
const letters = ['a', 'b', 'c', 'd'];
---

<Base title={c.title} description={c.description} lang={lang}>
  <h1>{c.title}</h1>
  <section class="sheet" aria-labelledby="h-harness">
    <div class="sh"><span class="bal lg fill" aria-hidden="true">3</span><h2 id="h-harness">{c.heading}</h2></div>
    <span class="draft">{tr('draft')}</span>
    <p class="lead">{c.lead}</p>

    <figure class="fig">
      <svg viewBox="0 0 320 190" role="img" aria-label={c.figureAria}>
        <rect class="d" pathLength="1" style="--i:0" x="8" y="6" width="94" height="34"/>
        <rect class="d" pathLength="1" style="--i:1" x="113" y="6" width="94" height="34"/>
        <rect class="d" pathLength="1" style="--i:2" x="218" y="6" width="94" height="34"/>
        <path class="d b" pathLength="1" style="--i:3" d="M55 40V50H265V62M260 56l5 6 5-6"/>
        <path class="d b" pathLength="1" style="--i:3" d="M160 40V50"/>
        <rect class="d" pathLength="1" style="--i:4" x="8" y="62" width="94" height="34"/>
        <path class="d b" pathLength="1" style="--i:5" d="M102 79H113M107 74l6 5-6 5"/>
        <rect class="d" pathLength="1" style="--i:6" x="113" y="62" width="94" height="34"/>
        <path class="d b" pathLength="1" style="--i:7" d="M207 79H218M213 74l5 5-5 5"/>
        <rect class="d" pathLength="1" style="--i:8" x="218" y="62" width="94" height="34"/>
        <path class="d b" pathLength="1" style="--i:9" d="M265 96V134M260 128l5 6 5-6"/>
        <rect class="d" pathLength="1" style="--i:10" x="218" y="134" width="94" height="34"/>
        <path class="d b" pathLength="1" style="--i:11" d="M218 151H207M213 146l-6 5 6 5"/>
        <rect class="d" pathLength="1" style="--i:12" x="113" y="134" width="94" height="34"/>
        <path class="d b" pathLength="1" style="--i:13" d="M113 151H55V96M50 102l5-6 5 6"/>
        <text class="fig-t s" x="55" y="27" text-anchor="middle">{l.vault}</text>
        <text class="fig-t s" x="160" y="27" text-anchor="middle">{l.exams}</text>
        <text class="fig-t s" x="265" y="27" text-anchor="middle">{l.memory}</text>
        <text class="fig-t" x="55" y="83" text-anchor="middle">{l.request}</text>
        <text class="fig-t" x="160" y="83" text-anchor="middle">{l.featureDoc}</text>
        <text class="fig-t bl" x="265" y="83" text-anchor="middle">{l.agent}</text>
        <text class="fig-t" x="265" y="155" text-anchor="middle">{l.checks}</text>
        <text class="fig-t" x="160" y="155" text-anchor="middle">{l.commit}</text>
      </svg>
      <figcaption>{c.figureCaption}</figcaption>
    </figure>

    <ol class="parts-l" aria-label={c.partsLabel}>
      {c.parts.map((part, i) => <li><span class="bal" aria-hidden="true">{letters[i]}</span>{part}</li>)}
    </ol>

    <div class="prose">
      {c.sections.map((s, i) => (
        <>
          <h3><span class="bal" aria-hidden="true">{letters[i]}</span> {s.heading}</h3>
          <p set:html={s.html} />
        </>
      ))}

      <p set:html={c.closingHtml} />
    </div>
  </section>
</Base>
