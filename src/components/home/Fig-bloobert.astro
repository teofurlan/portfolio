    <rect class="d" pathLength="1" style="--i:0" x="10" y="22" width="80" height="32" rx="16"/>
    <path class="d b" pathLength="1" style="--i:1" d="M90 38H190M184 33l6 5-6 5"/>
    <rect class="d" pathLength="1" style="--i:2" x="190" y="22" width="80" height="32" rx="16"/>
    <path class="d b" pathLength="1" style="--i:3" d="M230 54V116M225 110l5 6 5-6"/>
    <rect class="d" pathLength="1" style="--i:4" x="190" y="116" width="80" height="32" rx="16"/>
    <path class="d b" pathLength="1" style="--i:5" d="M190 132H90M96 127l-6 5 6 5"/>
    <rect class="d" pathLength="1" style="--i:6" x="10" y="116" width="80" height="32" rx="16"/>
    <path class="d b" pathLength="1" style="--i:7" d="M50 116V54M45 60l5-6 5 6"/>
