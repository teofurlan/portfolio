---
import { getCollection } from 'astro:content';
import AboutBlock from '../components/AboutBlock.astro';
import PostList from '../components/PostList.astro';
import ProjectMeta from '../components/ProjectMeta.astro';
import Rail from '../components/home/Rail.astro';
import { figures, proofs } from '../components/home/figures';
import Base from '../layouts/Base.astro';
import { hardwareProjects, showHardwareFilter } from '../lib/hardware';
import { featuredProjects } from '../lib/projects';

const all = await getCollection('projects');
const featured = featuredProjects(all);
const showHw = showHardwareFilter(all);
const hw = hardwareProjects(all);
const posts = await getCollection('writing');
const workNames = featured.map((p) => p.data.title).join(', ');
---

<Base title="Teo Furlan" description="Teo Furlan builds software with AI agents and robotics hardware. Entre Ríos, Argentina, open to remote.">
  <div class="shell" slot="shell">
    <Rail />
    <main id="main">
      <section class="hero" id="top" aria-labelledby="h-name">
        <h1 id="h-name">Teo Furlan</h1>
        <span class="draft">DRAFT — Teo rewrites</span>
        <p class="heroline">From a kid at a keyboard to agents and robot arms.</p>
        <p class="where">Entre Ríos, Argentina (UTC−3) · open to remote</p>
        <div class="legs">
          <div><b>Software with AI / agents</b><span class="sub">Socra, Bloobert, and the harness I work in.</span></div>
          <div><b>Hardware</b><span class="sub">Robotics, embedded: the MTDS surgical robot arm. Inverse kinematics validated against the CAD model to 3 micrometres.</span></div>
        </div>
        <table class="parts">
          <caption class="mono">Parts list · the page in five items</caption>
          <thead><tr><th scope="col">Item</th><th scope="col">Part</th><th scope="col">Description</th></tr></thead>
          <tbody>
            <tr><td class="n"><span class="bal" aria-hidden="true">1</span><span class="sr">1</span></td><th scope="row"><a href="#work">Work</a></th><td class="d">{workNames}.</td></tr>
            <tr><td class="n"><span class="bal" aria-hidden="true">2</span><span class="sr">2</span></td><th scope="row"><a href="#build">How this site was built</a></th><td class="d">The whole build conversation with the coding agent, replayed.</td></tr>
            <tr><td class="n"><span class="bal" aria-hidden="true">3</span><span class="sr">3</span></td><th scope="row"><a href="#ai">How I work with AI</a></th><td class="d">A harness around the agent: tasks, a learning vault, project exams and memory.</td></tr>
            <tr><td class="n"><span class="bal" aria-hidden="true">4</span><span class="sr">4</span></td><th scope="row"><a href="#writing">Writing</a></th><td class="d">{posts.length} posts on DEV.</td></tr>
            <tr><td class="n"><span class="bal" aria-hidden="true">5</span><span class="sr">5</span></td><th scope="row"><a href="#about">About / origin 2004</a></th><td class="d">From 2004 to a robot arm in 2026.</td></tr>
          </tbody>
        </table>
      </section>

      <section id="work" aria-labelledby="h-work">
        <div class="grp"><span class="bal lg fill" aria-hidden="true">1</span><h2 id="h-work">Work</h2><span class="mono">Sheets 1.1 – 1.{featured.length}</span></div>
        {showHw && (
          <nav class="hwf" aria-label="Hardware projects">
            <span class="mono">Hardware</span>
            <ul>{hw.map((p) => <li><a href={`/work/${p.id}/`}>{p.data.title}</a></li>)}</ul>
          </nav>
        )}
        {featured.map((p) => {
          const Fig = figures[p.id];
          return (
            <article class="sheet" aria-labelledby={`h-${p.id}`}>
              <div class="sh"><h3 id={`h-${p.id}`}><a class="sheet-link" href={`/work/${p.id}/`}>{p.data.title}</a></h3></div>
              <div class="two">
                <div>
                  <p class="lead">{p.data.summary}</p>
                  {proofs[p.id] && <div class="proof"><span class="mono">Proof</span>{proofs[p.id]}</div>}
                  <ProjectMeta project={p} />
                  <p><a href={`/work/${p.id}/`}>Read the case study<span class="sr">: {p.data.title}</span></a></p>
                </div>
                {Fig && <Fig />}
              </div>
            </article>
          );
        })}
      </section>

      <section class="sheet" id="build" aria-labelledby="h-built">
        <div class="sh"><span class="bal lg fill" aria-hidden="true">2</span><h2 id="h-built">How this site was built</h2></div>
        <p class="lead">The whole build conversation with the coding agent, replayed. Original Spanish, with an English translation.</p>
        <div class="links"><a class="btn solid" href="/build-session/">Watch the build session</a></div>
      </section>

      <section class="sheet" id="ai" aria-labelledby="h-ai">
        <div class="sh"><span class="bal lg fill" aria-hidden="true">3</span><h2 id="h-ai">How I work with AI</h2></div>
        <p class="lead">A harness around the agent: a workflow that tracks every task, a learning vault, project exams and memory.</p>
        <ol class="parts-l" aria-label="Parts of the harness">
          <li><span class="bal" aria-hidden="true">a</span>A workflow that tracks every task</li>
          <li><span class="bal" aria-hidden="true">b</span>A learning vault</li>
          <li><span class="bal" aria-hidden="true">c</span>Project exams</li>
          <li><span class="bal" aria-hidden="true">d</span>Memory</li>
        </ol>
        <div class="links"><a class="btn" href="/how-i-work/">Read how I work with AI</a></div>
      </section>

      <section class="sheet" id="writing" aria-labelledby="h-writing">
        <div class="sh"><span class="bal lg fill" aria-hidden="true">4</span><h2 id="h-writing">Writing</h2><span class="mono sub-ink">on DEV</span></div>
        <PostList />
        <p><a href="/writing/">All writing</a> · <a href="/rss.xml">RSS</a></p>
      </section>

      <section class="sheet" id="about" aria-labelledby="h-about">
        <div class="sh"><span class="bal lg fill" aria-hidden="true">5</span><h2 id="h-about">About</h2></div>
        <AboutBlock />
      </section>

      <section class="piece" aria-labelledby="h-piece">
        <svg viewBox="0 0 200 120" role="img" aria-label="Decoration: a simple three-link kinematic chain.">
          <path d="M20 100H70M30 100l-8 8M45 100l-8 8M60 100l-8 8" />
          <path d="M45 100L80 55L130 45L165 20" />
          <circle cx="45" cy="100" r="4" /><circle cx="80" cy="55" r="4" /><circle cx="130" cy="45" r="4" /><circle cx="165" cy="20" r="4" />
        </svg>
        <div>
          <h2 id="h-piece">Today's piece</h2>
          <p>A static drawing for now; a daily generated piece comes later · <a href="/decoration/">archive</a></p>
        </div>
      </section>
    </main>
  </div>
</Base>

<script>
  import '../scripts/rail';
</script>
