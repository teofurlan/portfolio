const devUrl = 'https://dev.to/teo_furlan/how-i-built-a-learning-system-inside-my-ai-coding-workflow-using-obsidian-fbp';
---

<Base title="How I work with AI" description="The harness around the agent: a workflow that tracks every task, a learning vault, project exams and memory.">
  <h1>How I work with AI</h1>
  <section class="sheet" aria-labelledby="h-harness">
    <div class="sh"><span class="bal lg fill" aria-hidden="true">3</span><h2 id="h-harness">The harness around the agent</h2></div>
    <span class="draft">DRAFT — Teo rewrites</span>
    <p class="lead">I do not just prompt an agent. I run it inside a harness: a workflow that tracks every task, a learning vault, project exams and memory.</p>

    <figure class="fig">
      <svg viewBox="0 0 320 190" role="img" aria-label="Diagram of the harness. A loop runs from request to feature doc to agent to checks to commit and back to request. The learning vault, exams and memory are side blocks attached to the agent.">
        <rect class="d" pathLength="1" style="--i:0" x="8" y="6" width="94" height="34"/>
        <rect class="d" pathLength="1" style="--i:1" x="113" y="6" width="94" height="34"/>
        <rect class="d" pathLength="1" style="--i:2" x="218" y="6" width="94" height="34"/>
        <path class="d b" pathLength="1" style="--i:3" d="M55 40V50H265V62M260 56l5 6 5-6"/>
        <path class="d b" pathLength="1" style="--i:3" d="M160 40V50"/>
        <rect class="d" pathLength="1" style="--i:4" x="8" y="62" width="94" height="34"/>
        <path class="d b" pathLength="1" style="--i:5" d="M102 79H113M107 74l6 5-6 5"/>
        <rect class="d" pathLength="1" style="--i:6" x="113" y="62" width="94" height="34"/>
        <path class="d b" pathLength="1" style="--i:7" d="M207 79H218M213 74l5 5-5 5"/>
        <rect class="d" pathLength="1" style="--i:8" x="218" y="62" width="94" height="34"/>
        <path class="d b" pathLength="1" style="--i:9" d="M265 96V134M260 128l5 6 5-6"/>
        <rect class="d" pathLength="1" style="--i:10" x="218" y="134" width="94" height="34"/>
        <path class="d b" pathLength="1" style="--i:11" d="M218 151H207M213 146l-6 5 6 5"/>
        <rect class="d" pathLength="1" style="--i:12" x="113" y="134" width="94" height="34"/>
        <path class="d b" pathLength="1" style="--i:13" d="M113 151H55V96M50 102l5-6 5 6"/>
        <text class="fig-t s" x="55" y="27" text-anchor="middle">vault</text>
        <text class="fig-t s" x="160" y="27" text-anchor="middle">exams</text>
        <text class="fig-t s" x="265" y="27" text-anchor="middle">memory</text>
        <text class="fig-t" x="55" y="83" text-anchor="middle">request</text>
        <text class="fig-t" x="160" y="83" text-anchor="middle">feature doc</text>
        <text class="fig-t bl" x="265" y="83" text-anchor="middle">agent</text>
